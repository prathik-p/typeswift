{
  "manifest_version": 3,
  "name": "TypeSwift",
  "version": "1.1.0",
  "description": "Type a prefix plus a short code (like ;addr) and TypeSwift expands it into your saved text in any text box.",
  "browser_specific_settings": {
    "gecko": {
      "id": "typeswift@prathik-p",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TypeSwift",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true }
}
